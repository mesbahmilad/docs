{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Wundernode Docs",
  "description": "Artist-friendly guides and node references for creating images, videos, and audio with Wundernode.",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://www.wundernode.com"
  },
  "favicon": {
    "light": "/assets/favicon-light.png",
    "dark": "/assets/favicon-dark.png"
  },
  "colors": {
    "primary": "#4F46E5",
    "light": "#6D28D9",
    "dark": "#312E81"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": { "theme": "github-light" }
  },
  "topbarCta": {
    "label": "Open Wundernode",
    "href": "https://app.wundernode.com"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "index",
          "get-started/first-image",
          "get-started/first-video",
          "get-started/what-are-nodes"
        ]
      },
      {
        "group": "Image Nodes",
        "pages": [
          "nodes/image/text-to-image",
          "nodes/image/image-editor",
          "nodes/image/image-upscale"
        ]
      },
      {
        "group": "Video Nodes",
        "pages": [
          "nodes/video/text-to-video",
          "nodes/video/image-to-video",
          "nodes/video/talking-portrait",
          "nodes/video/lip-sync",
          "nodes/video/frame-interpolation"
        ]
      },
      {
        "group": "Audio Nodes",
        "pages": [
          "nodes/audio/voice-generator"
        ]
      },
      {
        "group": "Text Nodes",
        "pages": [
          "nodes/text/generate-text"
        ]
      },
      {
        "group": "Input Nodes",
        "pages": [
          "nodes/input/text-display",
          "nodes/input/image",
          "nodes/input/video",
          "nodes/input/audio"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Community",
          "icon": "discord",
          "href": "https://discord.gg/tmWxHxVWCc"
        }
      ]
    }
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/tmWxHxVWCc"
    }
  },
  "interaction": {
    "drilldown": false
  },
  "seo": {
    "title": "Wundernode Docs",
    "description": "Learn how to create stunning images and videos using Wundernode. Visual guides, presets, and node tips for artists."
  }
}
